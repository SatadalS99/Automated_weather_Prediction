# .env.example
#
# Copy this file to .env and fill in your values.
# The .env file is GITIGNORED — never commit it to GitHub.
#
# Load in Python with: from dotenv import load_dotenv; load_dotenv()
# (already handled in run_pipeline.py)
#
# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/weather.db

# ── Telegram (optional) ───────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
# Get chat_id from @userinfobot on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email / Gmail (optional) ──────────────────────────────────────────────────
# Requires Gmail App Password (NOT your main Google password)
# Enable at: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_FROM=yourname@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_TO=yourname@gmail.com
